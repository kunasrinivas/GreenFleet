# Provision independently; never put the Google web-service key into Android.
GOOGLE_MAPS_SERVER_KEY=
# Random bearer token, at least 32 characters, provisioned into the app Settings.
# One private MVP operator. Replace with per-user short-lived auth for a public service.
GREENFLEET_ACCESS_TOKEN=
PORT=8443
HOST=127.0.0.1
# HTTPS is mandatory. Paths to your locally provisioned certificate and private key.
TLS_CERT_PATH=
TLS_KEY_PATH=

